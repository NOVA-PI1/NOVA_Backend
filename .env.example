APP_NAME="Nova Backend"
ENVIRONMENT="development"
CORS_ALLOWED_ORIGINS="http://localhost:8501"

LLM_PROVIDER="openai"
LLM_MODEL="gpt-4.1-mini"
LLM_MAX_TOKENS=900
OPENAI_API_KEY="reemplaza_esta_clave"

# Desarrollo local
DATABASE_URL="sqlite:///./nova.db"

# Produccion beta con Supabase, Neon, Render, Railway, etc.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# RAG local persistente para beta. Para produccion robusta evaluar pgvector/Qdrant/Pinecone.
CHROMA_PERSIST_PATH="./chroma_db"
BCL_COLLECTION_NAME="nova_bcl"
BCL_RELEVANCE_THRESHOLD=0.8
